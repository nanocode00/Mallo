# 실제 값은 .env에만 적으세요 (커밋 금지). 이 파일은 필요한 키 목록만 공유하는 용도입니다.

# Models (지정하지 않으면 models/ 하위 기본 경로 사용)
MALLO_STT_MODEL_PATH=models/stt/final-train65-merged-bf16
MALLO_NLU_MODEL_PATH=models/nlu/final-qwen06b-merged-bf16
MALLO_TTS_MODEL_DIR=models/tts/mallo-friendly

# AIHub (데이터 다운로드 및 API 사용 시 필요)
AIHUB_API_KEY=

# Cloudflare (Named Tunnel 구동 시 사용, 실제 토큰 값은 .env에만 설정)
CLOUDFLARE_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
