{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallo.local/schemas/menu.schema.json",
  "title": "Mallo Menu Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "currency", "categories", "menu_aliases", "tag_definitions", "items"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "currency": {"const": "KRW"},
    "categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/category"}
    },
    "menu_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/menuAlias"}
    },
    "tag_definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tagDefinition"}
    },
    "items": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/menuItem"}
    }
  },
  "$defs": {
    "snakeCaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sort_order"],
      "properties": {
        "id": {"$ref": "#/$defs/snakeCaseId"},
        "name": {"type": "string", "minLength": 1},
        "sort_order": {"type": "integer", "minimum": 1}
      }
    },
    "tagDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases"],
      "properties": {
        "id": {"$ref": "#/$defs/snakeCaseId"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "menuAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "target_item_id", "temperature"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "target_item_id": {"$ref": "#/$defs/snakeCaseId"},
        "temperature": {
          "type": ["string", "null"],
          "enum": ["hot", "iced", null]
        }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category_id",
        "name",
        "description",
        "base_price",
        "unit",
        "temperature_options",
        "tags",
        "option_policy",
        "price_source_brand",
        "price_source_menu_name",
        "price_source_url",
        "price_checked_at"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/snakeCaseId"},
        "category_id": {"$ref": "#/$defs/snakeCaseId"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "base_price": {"type": "integer", "minimum": 1},
        "unit": {"enum": ["잔", "개"]},
        "temperature_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["hot", "iced"]}
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/snakeCaseId"}
        },
        "option_policy": {"$ref": "#/$defs/menuOptionPolicy"},
        "price_source_brand": {"type": "string", "minLength": 1},
        "price_source_menu_name": {"type": "string", "minLength": 1},
        "price_source_url": {"type": "string", "format": "uri"},
        "price_checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "menuOptionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_supported",
        "shot_supported",
        "decaf_available",
        "syrup_supported",
        "ice_amount_available"
      ],
      "properties": {
        "size_supported": {"type": "boolean"},
        "shot_supported": {"type": "boolean"},
        "decaf_available": {"type": "boolean"},
        "syrup_supported": {"type": "boolean"},
        "ice_amount_available": {"type": "boolean"}
      }
    }
  }
}
